{
  "name": "leyline",
  "productName": "Leyline",
  "version": "0.1.6",
  "description": "Keeps World of Warcraft settings and addons in sync between your computers through your own NAS.",
  "license": "MIT",
  "type": "module",
  "main": "app/main.mjs",
  "scripts": {
    "start": "electron .",
    "fetch-rclone": "node scripts/fetch-rclone.mjs",
    "icons": "node scripts/make-icons.mjs",
    "dist:win": "node scripts/fetch-rclone.mjs win32-x64 && electron-builder --win nsis --x64 --publish never",
    "dist:mac": "node scripts/fetch-rclone.mjs darwin-arm64 && electron-builder --mac dmg zip --arm64 --publish never"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.1"
  },
  "overrides": {
    "minimatch@^9.0.0": "^11.0.1",
    "minimatch@^10.0.0": "^11.0.1"
  },
  "author": "Leyline contributors",
  "build": {
    "appId": "app.leyline.desktop",
    "productName": "Leyline",
    "copyright": "MIT licensed. Not affiliated with Blizzard Entertainment.",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**",
      "engine/**",
      "package.json",
      "!**/*.md"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "app/assets/icon-512.png",
      "extraResources": [
        {
          "from": "vendor/rclone/win32-x64/",
          "to": "rclone",
          "filter": [
            "rclone.exe"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "artifactName": "Leyline-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "app/assets/icon-1024.png",
      "category": "public.app-category.utilities",
      "extendInfo": {
        "LSUIElement": false,
        "NSLocalNetworkUsageDescription": "Leyline connects to your NAS on the local network to sync your World of Warcraft settings and addons."
      },
      "extraResources": [
        {
          "from": "vendor/rclone/darwin-${arch}/",
          "to": "rclone",
          "filter": [
            "rclone"
          ]
        }
      ],
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "wrngwrld",
        "repo": "leyline"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
